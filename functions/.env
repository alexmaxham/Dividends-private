# Non-secret function settings. API keys are secrets (see README), never put them here.
PLAID_ENV=production
PLAID_REDIRECT_URI=https://alexmaxham.github.io/Dividends-private/
# Market data: Massive (formerly Polygon.io). The free plan allows 5 calls a minute; raise this on a paid plan.
MARKET_API_BASE=https://api.massive.com
MARKET_CALLS_PER_MINUTE=5
# Notifications. Every setting the functions read must be listed here, or an unattended deploy stops to ask for it.
# The deploy workflow fills these in from the repository variables of the same name, when they're set.
EMAIL_FROM="Dividends <onboarding@resend.dev>"
VAPID_PUBLIC_KEY=
