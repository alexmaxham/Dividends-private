{
  "name": "dividends-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-dividends 'vitest run --no-file-parallelism'",
    "deploy": "firebase deploy --only firestore,functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
